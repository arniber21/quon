-- RUN: %quonc %s --target %S/../../../targets/neutral_atom/generic_rna_v0.json --emit-na-mlir - --quiet | %FileCheck %s
--
-- Rydberg-spacing regression: two disjoint CNOTs. Adjacent entanglement
-- pair columns are only 10-12 um apart, inside min_rydberg_spacing_um
-- (18.75 um), so a same-layer assignment has to spread them to x = 0/2 and
-- x = 24/26. That spread crosses AOD columns, so the same-layer move takes
-- two groups and the farther column is one microsecond longer. With the
-- target's cost_model weights, giving each CNOT its own Rydberg stage is
-- cheaper. Each stage uses a 2 um partner pair: atoms 0 and 2 at x = 0/2
-- (cycle 21), atoms 1 and 3 at x = 12/14 (cycle 25).
--
-- Issue #298: `H @0 |> H @2` are preserved (local `rz` + a
-- Hahn-echo-refocused global `ry` raster each — every other trapped atom
-- gets a local `Rz(pi)`/`Rz(-pi)` echo pair around the raster's second half
-- so it provably doesn't also rotate; see
-- `quon_na::pipeline::push_global_ry_with_refocus` — before any movement).

fn two_bells(): Circuit<4, 4, 4, Clifford> = circuit {
        H @0 |> H @2 |> CNOT @(0, 1) |> CNOT @(2, 3)
}

fn par_na(): Q<List<Bit>> = run {
        q <- (two_bells()) @ (qreg 4)
        measure_all q
}

-- CHECK: "quantum.na.schedule"()
--
-- The first movement stage shuttles one pair into the entanglement zone.
-- CHECK: "quantum.na.transfer"()
-- CHECK-SAME: direction = "slm_to_aod"
-- CHECK: "quantum.na.move"()
-- CHECK: "quantum.na.transfer"()
-- CHECK-SAME: direction = "aod_to_slm"
--
-- Each CNOT is its own Rydberg stage, on a 2 um partner pair.
-- CHECK: "quantum.na.entangle"()
-- CHECK-SAME: x_um\22:0.0
-- CHECK-SAME: x_um\22:2.0
-- CHECK: cycle = 21 : i64
-- CHECK: "quantum.na.entangle"()
-- CHECK-SAME: x_um\22:12.0
-- CHECK-SAME: x_um\22:14.0
-- CHECK: cycle = 25 : i64
--
-- CHECK: min_rydberg_spacing_um = 1.875000e+01
-- CHECK-SAME: target_id = "generic_reconfigurable_neutral_atom_v0"
